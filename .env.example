# PostgreSQL
DB_USER=stocklens
DB_PASSWORD=change-me
DB_NAME=stocklens
DATABASE_URL=postgresql+psycopg://stocklens:change-me@db:5432/stocklens
DATABASE_URL_ASYNC=postgresql+asyncpg://stocklens:change-me@db:5432/stocklens

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_URL=http://api:8000
# TTL кэша Redis для свечей и прочих ресурсов (секунды)
# CACHE_TTL_CANDLES_SECONDS=3600
# CACHE_TTL_DEFAULT_SECONDS=300

# Авторизация API (JWT; mode=local сейчас, oidc — для Keycloak)
AUTH_MODE=local
AUTH_ISSUER=https://stocklens.local
AUTH_AUDIENCE=stocklens-api
AUTH_SECRET=change-me-strong-secret-min-32-bytes
AUTH_OWNER_USERNAME=admin
AUTH_OWNER_PASSWORD=change-me
AUTH_TOKEN_TTL_SECONDS=3600
# AUTH_JWKS_URL=  # только для AUTH_MODE=oidc (JWKS Keycloak)

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Telegram
TELEGRAM_BOT_TOKEN=change-me
# Chat_id владельца для планового дайджеста 08:30 МСК (B3); алерты идут в chat_id подписки.
DIGEST_CHAT_ID=0
# Необязательно (есть дефолты): интервал опроса алертов и время дайджеста по МСК
# ALERT_POLL_INTERVAL_MINUTES=30
# DIGEST_HOUR_MSK=8
# DIGEST_MINUTE_MSK=30

# Вселенная тикеров (по умолчанию — состав IMOEX, см. seed в stocklens-core)
TICKERS_UNIVERSE=IMOEX

# Sentiment-модель (значения по умолчанию совпадают с Dockerfile ENV)
# SENTIMENT_MODEL_DIR=/app/model_onnx
# SENTIMENT_MODEL_ID=cointegrated/rubert-tiny-sentiment-balanced
